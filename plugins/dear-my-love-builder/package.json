{
  "name": "@local/dear-my-love-builder",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A safe local builder for the Dear, My Love Vite website project.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/*.mjs"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
